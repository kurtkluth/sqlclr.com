# Line endings are decided here, not by each machine's core.autocrlf setting.
# Everything is stored LF in the repository and checked out native on Windows,
# so the Linux CI builder and a Windows working copy agree on file contents.

* text=auto

# Source and config: always LF, on every platform.
*.astro   text eol=lf
*.ts      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.svg     text eol=lf
*.html    text eol=lf
*.txt     text eol=lf

# PowerShell stays CRLF: it is a Windows-only tool script and that is the
# native convention for it.
*.ps1     text eol=crlf

# Binary — never touch these.
*.png     binary
*.jpg     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary

# Generated: GitHub collapses this in review instead of letting a thousand-line
# dependency diff drown out real changes. Still tracked and still committed.
package-lock.json linguist-generated=true
